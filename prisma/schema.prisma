generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  passwordHash     String    @default("")
  displayName      String    @default("Joueur")
  accountCode      String?   @unique
  role             String    @default("user")
  playMode         String    @default("local")
  localPlayersJson String?
  name             String?
  emailVerified    DateTime?
  image            String?
  banType          String?
  bannedUntil      DateTime?
  banComment       String?
  bannedAt         DateTime?
  bannedById       String?
  lastCountry      String?
  lastIp           String?
  lastSeenAt       DateTime?
  lastLoginAt      DateTime?
  totalPresenceSeconds Int   @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  stats            Stats[]
  achievements     Achievement[]
  sessions         Session[]
  banEvents            AccountBanEvent[]    @relation("BanTarget")
  bansIssued           AccountBanEvent[]    @relation("BanActor")
  passwordResetTokens  PasswordResetToken[]
  feedback             UserFeedback[]
}

model AccountBanEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("BanActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  comment     String?
  bannedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model SitePresence {
  visitorId String   @id
  userId    String?
  country   String?
  lastIp    String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
  @@index([userId])
  @@index([country])
  @@index([lastIp])
}

model DailyVisitor {
  visitorId String
  date      String

  @@id([visitorId, date])
  @@index([date])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Stats {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  gameType  String
  score     Int
  playedAt  DateTime @default(now())
  metadata  String?
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  unlockedAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserFeedback {
  id           String   @id @default(cuid())
  type         String
  message      String
  screenshots  String?
  pageUrl      String?
  userAgent    String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactEmail String?
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}
