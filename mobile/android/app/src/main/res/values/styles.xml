<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Thème posé par BridgeActivity une fois lancée. Bord à bord imposé (targetSdk 36) :
         sans viewport-fit=cover, le plugin SystemBars décale la WebView et la zone des barres
         montre windowBackground. Ce doit être une COULEUR (SystemBars lit typedValue.data),
         sinon bande claire ou grise autour du feutre vert. statusBarColor et
         navigationBarColor servent jusqu'à Android 14 ; les icônes claires viennent de
         SystemBars.style = DARK (capacitor.config.json). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/felt_deep</item>
        <item name="android:statusBarColor">@color/felt_deep</item>
        <item name="android:navigationBarColor">@color/felt_deep</item>
    </style>


    <!-- Lancement : splash.png jusqu'à Android 11 ; à partir d'Android 12, splash système
         (icône de l'app) sur le feutre plutôt que sur le fond clair par défaut. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/felt_deep</item>
    </style>
</resources>
