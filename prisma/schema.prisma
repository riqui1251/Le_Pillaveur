generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  passwordHash     String    @default("")
  displayName      String    @default("Joueur")
  onlineDisplayName String?
  onlinePreferencesJson String?
  accountCode      String?   @unique
  role             String    @default("user")
  // Compte invité (QR scanné) : pseudo temporaire sans email ni mot de passe,
  // purgé automatiquement après inactivité (retention-sweep).
  isGuest          Boolean   @default(false)
  playMode         String    @default("local")
  ambianceMode     String    @default("alcool")
  locale           String    @default("fr")
  localPlayersJson String?
  name             String?
  emailVerified    DateTime?
  image            String?
  banType          String?
  bannedUntil      DateTime?
  banComment       String?
  bannedAt         DateTime?
  bannedById       String?
  lastCountry      String?
  lastIp           String?
  lastDevice       String?
  lastSeenAt       DateTime?
  lastLoginAt      DateTime?
  totalPresenceSeconds Int   @default(0)
  onlineXp         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  stats            Stats[]
  achievements     Achievement[]
  sessions         Session[]
  hostedRooms      OnlineRoom[]       @relation("HostedRooms")
  roomMemberships  OnlineRoomMember[]
  roomInvitesReceived OnlineRoomInvite[] @relation("RoomInvitesReceived")
  roomInvitesSent     OnlineRoomInvite[] @relation("RoomInvitesSent")
  friendshipsSent     Friendship[]       @relation("FriendshipsSent")
  friendshipsReceived Friendship[]       @relation("FriendshipsReceived")
  banEvents            AccountBanEvent[]    @relation("BanTarget")
  bansIssued           AccountBanEvent[]    @relation("BanActor")
  passwordResetTokens  PasswordResetToken[]
  feedback             UserFeedback[]
  nameModerationAttempts NameModerationAttempt[]
  nameModerationWarnedAt DateTime?
  nameModerationWarningDismissedAt DateTime?
  chatMessages          ChatMessage[]      @relation("ChatMessages")
  chatReads             ChatRead[]         @relation("ChatReads")
  featureBans           FeatureBan[]       @relation("FeatureBanTarget")
  featureBansIssued     FeatureBan[]       @relation("FeatureBanActor")
  onlineMatchResults    OnlineMatchResult[]
  cosmeticGrants        CosmeticGrant[]    @relation("CosmeticGrantTarget")
  cosmeticGrantsIssued  CosmeticGrant[]    @relation("CosmeticGrantActor")
}

model ChatRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("ChatReads", fields: [userId], references: [id], onDelete: Cascade)
  channel    String
  lastReadAt DateTime @default(now())

  @@unique([userId, channel])
}

model ChatMessage {
  id        String   @id @default(cuid())
  /** Canal : `room:<roomId>` (partie) ou `friend:<idA>:<idB>` (ids triés). */
  channel   String
  senderId  String
  sender    User     @relation("ChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
}

model OnlineRoom {
  id                    String   @id @default(cuid())
  code                  String   @unique
  hostUserId            String
  host                  User     @relation("HostedRooms", fields: [hostUserId], references: [id], onDelete: Cascade)
  status                String   @default("waiting")
  visibility            String   @default("public")
  gameId                String?
  selectedMemberIdsJson String?
  settingsJson          String?
  gameStateJson         String?
  /// Briefing tuto avant la partie : { startedAt: number, acks: string[] }
  briefingJson          String?
  stateVersion          Int      @default(0)
  currentTurnUserId     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  members               OnlineRoomMember[]
  invites               OnlineRoomInvite[]

  @@index([status, visibility, gameId])
}

model OnlineRoomInvite {
  id            String     @id @default(cuid())
  roomId        String
  room          OnlineRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invitedUserId String
  invitedUser   User       @relation("RoomInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User       @relation("RoomInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  status        String     @default("pending")
  createdAt     DateTime   @default(now())
  respondedAt   DateTime?

  @@unique([roomId, invitedUserId])
  @@index([invitedUserId, status])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model OnlineRoomMember {
  id         String     @id @default(cuid())
  roomId     String
  room       OnlineRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isReady    Boolean    @default(false)
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime   @default(now())

  @@unique([roomId, userId])
}

// Résultat d'une partie EN LIGNE terminée : une ligne par COMPTE humain.
// Historique brut (jamais mis à jour) — victoires/défaites/% agrégés à la
// lecture. Les gorgées n'entrent pas dans le classement. Pas de FK vers
// OnlineRoom : la salle est éphémère, le résultat lui survit.
model OnlineMatchResult {
  id          String   @id @default(cuid())
  roomId      String
  gameId      String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome     String // 'win' | 'loss'
  // Rang final quand le jeu en produit un (Quiz) — null sinon.
  rank        Int?
  // Effectif total de la partie (bots inclus) et comptes humains.
  playerCount Int
  humanCount  Int
  finishedAt  DateTime @default(now())

  @@index([gameId, userId])
  @@index([userId, finishedAt])
}

// Déblocage MANUEL d'un cosmétique (effet de pseudo / cadre) par un fondateur.
// La clé cosmétique = `kind:id` (ex. `frame:diamond`) — voir src/lib/online/cosmetics.ts.
model CosmeticGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("CosmeticGrantTarget", fields: [userId], references: [id], onDelete: Cascade)
  cosmeticKey String
  grantedById String?
  grantedBy   User?    @relation("CosmeticGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([userId, cosmeticKey])
}

model AccountBanEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("BanActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  comment     String?
  bannedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model SitePresence {
  visitorId        String   @id
  userId           String?
  country          String?
  lastIp           String?
  lastDevice       String?
  localPlayerCount Int      @default(0)
  localPlayerNames String?
  firstSeen        DateTime @default(now())
  lastSeen         DateTime @default(now())

  @@index([lastSeen])
  @@index([userId])
  @@index([country])
  @@index([lastIp])
}

model IpSeenLog {
  id         String   @id @default(cuid())
  subjectKey String
  ip         String
  country    String?
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())

  @@unique([subjectKey, ip])
  @@index([subjectKey])
  @@index([ip])
}

model DailyVisitor {
  visitorId String
  date      String

  @@id([visitorId, date])
  @@index([date])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Stats {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  gameType  String
  score     Int
  playedAt  DateTime @default(now())
  metadata  String?
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  unlockedAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserFeedback {
  id           String   @id @default(cuid())
  type         String
  message      String
  screenshots  String?
  pageUrl      String?
  userAgent    String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactEmail String?
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model ModerationTerm {
  id        String   @id @default(cuid())
  term      String
  locale    String?
  note      String?
  addedById String?
  createdAt DateTime @default(now())

  @@unique([term, locale])
  @@index([locale])
}

model NameModerationAttempt {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorId     String?
  attemptedName String
  reason        String
  context       String
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
  @@index([reason, createdAt])
  @@index([createdAt])
}

/// Réglages globaux du site (clé/valeur). Ex. : voiceEnabled = "1" | "0".
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Bannissement CIBLÉ d'une fonctionnalité (vocal ou chat écrit), indépendant
/// du ban de compte. `until` null = permanent ; sinon expire à cette date.
model FeatureBan {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("FeatureBanTarget", fields: [userId], references: [id], onDelete: Cascade)
  feature   String    // 'voice' | 'chat'
  until     DateTime?
  comment   String?
  actorId   String?
  actor     User?     @relation("FeatureBanActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@unique([userId, feature])
  @@index([userId])
}
