generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  passwordHash     String    @default("")
  displayName      String    @default("Joueur")
  onlineDisplayName String?
  onlinePreferencesJson String?
  accountCode      String?   @unique
  role             String    @default("user")
  // Compte invité : pseudo saisi pour rejoindre une table (code ou QR, JoinGate)
  // ou pour « Essayer avec des bots » (TryBotsGate), sans email ni mot de passe,
  // purgé automatiquement après inactivité (retention-sweep).
  isGuest          Boolean   @default(false)
  playMode         String    @default("local")
  ambianceMode     String    @default("alcool")
  locale           String    @default("fr")
  localPlayersJson String?
  name             String?
  emailVerified    DateTime?
  image            String?
  banType          String?
  bannedUntil      DateTime?
  banComment       String?
  bannedAt         DateTime?
  bannedById       String?
  lastCountry      String?
  lastIp           String?
  lastDevice       String?
  lastSeenAt       DateTime?
  lastLoginAt      DateTime?
  // Cumul HÉRITÉ, plus alimenté depuis le lot 5 (60 s par requête, onglets
  // cachés compris : surestimé) et remis à zéro par la migration
  // 20260912130100_legacy_consent_cleanup. Colonne gardée : la supprimer en
  // SQLite oblige à reconstruire la table. Le temps d'un compte se lit dans
  // AccountVisit.
  totalPresenceSeconds Int   @default(0)
  onlineXp         Int       @default(0)
  // Série quotidienne : nombre de jours consécutifs avec au moins une partie
  // comptée, et dernier jour crédité (date Paris 'YYYY-MM-DD') — mis à jour
  // au trafic dans recordMatchResults, aucun cron.
  streakCount      Int       @default(0)
  streakLastDay    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  stats            Stats[]
  achievements     Achievement[]
  sessions         Session[]
  accountVisits    AccountVisit[]
  hostedRooms      OnlineRoom[]       @relation("HostedRooms")
  roomMemberships  OnlineRoomMember[]
  roomInvitesReceived OnlineRoomInvite[] @relation("RoomInvitesReceived")
  roomInvitesSent     OnlineRoomInvite[] @relation("RoomInvitesSent")
  friendshipsSent     Friendship[]       @relation("FriendshipsSent")
  friendshipsReceived Friendship[]       @relation("FriendshipsReceived")
  banEvents            AccountBanEvent[]    @relation("BanTarget")
  bansIssued           AccountBanEvent[]    @relation("BanActor")
  passwordResetTokens  PasswordResetToken[]
  feedback             UserFeedback[]
  nameModerationAttempts NameModerationAttempt[]
  nameModerationWarnedAt DateTime?
  nameModerationWarningDismissedAt DateTime?
  chatMessages          ChatMessage[]      @relation("ChatMessages")
  chatReads             ChatRead[]         @relation("ChatReads")
  featureBans           FeatureBan[]       @relation("FeatureBanTarget")
  featureBansIssued     FeatureBan[]       @relation("FeatureBanActor")
  onlineMatchResults    OnlineMatchResult[]
  onlineGameHistory     OnlineGameHistory[]
  onlineGameSessions    OnlineGameSessionPlayer[] @relation("OnlineGameSessionPlayer")
  cosmeticGrants        CosmeticGrant[]    @relation("CosmeticGrantTarget")
  cosmeticGrantsIssued  CosmeticGrant[]    @relation("CosmeticGrantActor")
  abuseReportsSent      AbuseReport[]      @relation("AbuseReportReporter")
  abuseReportsReceived  AbuseReport[]      @relation("AbuseReportTarget")
  abuseReportsReviewed  AbuseReport[]      @relation("AbuseReportReviewer")
  blocksMade            UserBlock[]        @relation("UserBlockBlocker")
  blocksReceived        UserBlock[]        @relation("UserBlockBlocked")

  // Balayage des invités (retention-sweep) : isGuest puis borne sur
  // lastSeenAt. Sans index, chaque passage lisait la table entière.
  @@index([isGuest, lastSeenAt])
}

model ChatRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("ChatReads", fields: [userId], references: [id], onDelete: Cascade)
  channel    String
  lastReadAt DateTime @default(now())

  @@unique([userId, channel])
}

model ChatMessage {
  id        String   @id @default(cuid())
  /** Canal : `room:<roomId>` (partie) ou `friend:<idA>:<idB>` (ids triés). */
  channel   String
  senderId  String
  sender    User     @relation("ChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  // SQLite n'indexe pas les clés étrangères : la cascade d'une suppression
  // de compte scannait 12 mois de messages pour trouver ceux de l'auteur.
  @@index([senderId])
}

model OnlineRoom {
  id                    String   @id @default(cuid())
  code                  String   @unique
  hostUserId            String
  host                  User     @relation("HostedRooms", fields: [hostUserId], references: [id], onDelete: Cascade)
  status                String   @default("waiting")
  visibility            String   @default("public")
  gameId                String?
  selectedMemberIdsJson String?
  settingsJson          String?
  gameStateJson         String?
  /// Briefing tuto avant la partie : { startedAt: number, acks: string[] }
  briefingJson          String?
  stateVersion          Int      @default(0)
  currentTurnUserId     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  members               OnlineRoomMember[]
  invites               OnlineRoomInvite[]

  @@index([status, visibility, gameId])
  // « Ma salle » (hôte) et cascade de suppression de compte : clé étrangère
  // non indexée par SQLite.
  @@index([hostUserId])
}

model OnlineRoomInvite {
  id            String     @id @default(cuid())
  roomId        String
  room          OnlineRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invitedUserId String
  invitedUser   User       @relation("RoomInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User       @relation("RoomInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  status        String     @default("pending")
  createdAt     DateTime   @default(now())
  respondedAt   DateTime?

  @@unique([roomId, invitedUserId])
  @@index([invitedUserId, status])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model OnlineRoomMember {
  id         String     @id @default(cuid())
  roomId     String
  room       OnlineRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isReady    Boolean    @default(false)
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime   @default(now())

  @@unique([roomId, userId])
  // L'unique ci-dessus commence par roomId : il ne sert ni à « dans quelle
  // salle suis-je » ni à la cascade de suppression de compte.
  @@index([userId])
}

// Résultat d'une partie EN LIGNE terminée : une ligne par COMPTE humain.
// Historique brut (jamais mis à jour) — victoires/défaites/% agrégés à la
// lecture. Les gorgées n'entrent pas dans le classement. Pas de FK vers
// OnlineRoom : la salle est éphémère, le résultat lui survit.
model OnlineMatchResult {
  id          String   @id @default(cuid())
  roomId      String
  gameId      String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome     String // 'win' | 'loss'
  // Rang final quand le jeu en produit un (Quiz) — null sinon.
  rank        Int?
  // Effectif total de la partie (bots inclus) et comptes humains.
  playerCount Int
  humanCount  Int
  finishedAt  DateTime @default(now())

  @@index([gameId, userId])
  @@index([userId, finishedAt])
  // Classement hebdo : filtre `finishedAt >= lundi` sans scan complet.
  @@index([finishedAt])
}

// Derniers jeux joués en ligne : une ligne par couple (user, jeu), horodatée
// à chaque lancement de partie (launchOnlineRoom) — couvre aussi les parties
// contre bots et les rematchs, contrairement à OnlineMatchResult. Purgée avec
// le compte (cascade), donc avec les invités via le retention-sweep.
model OnlineGameHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId       String
  lastPlayedAt DateTime @default(now())
  playCount    Int      @default(1)

  @@unique([userId, gameId])
  @@index([userId, lastPlayedAt])
}

// JOURNAL DES PARTIES : une ligne par partie LANCÉE (pas par partie gagnée).
// Ni OnlineGameHistory (un compteur par couple joueur/jeu) ni OnlineMatchResult
// (les seules parties terminées AVEC classement) ne disent à l'exploitant ce
// qui a réellement été lancé : une partie abandonnée, ou un jeu qui ne produit
// aucun classement, ne laissaient aucune trace. La ligne naît donc au
// lancement, et `endedAt` reste NUL tant que la partie tourne.
// Une revanche est une NOUVELLE ligne : c'est une autre partie, même salle.
// Pas de clé étrangère vers OnlineRoom : la salle est éphémère (purgée à
// l'abandon), le journal lui survit — `roomId` et `code` restent des repères.
// Chaque point où une salle s'arrête ou disparaît ferme donc la ligne LUI-MÊME,
// avec la meilleure date connue et son motif (`endReason`) : jamais l'heure à
// laquelle la Supervision lit le journal (voir src/lib/online/game-sessions.ts).
model OnlineGameSession {
  id           String    @id @default(cuid())
  roomId       String
  code         String
  gameId       String
  /// Visibilité de la table AU LANCEMENT ('public' | 'private' | 'invite').
  /// 'unknown' pour les lignes antérieures à cette colonne. Côté guichet, tout
  /// ce qui n'est pas 'public' reste anonyme : ni jeu, ni effectif.
  visibility   String    @default("unknown")
  startedAt    DateTime  @default(now())
  /// Null = partie encore en cours (ou salle disparue avant réconciliation).
  endedAt      DateTime?
  /// Motif de fermeture, qui dit si la durée est fiable :
  ///  - 'finished' (fin de partie) et 'rematch' (revanche relancée) : SÛRE ;
  ///  - 'left' (dernier membre parti, compte hôte supprimé), 'staff' (table
  ///    fermée d'office) et 'abandoned' (salle purgée ou qui ne joue plus,
  ///    datée à sa dernière écriture ; plafond de 12 h) : ESTIMÉE ;
  ///  - 'unknown' : salle disparue sans fermeture, endedAt = startedAt, durée
  ///    exclue des totaux.
  /// Null = ligne antérieure à cette colonne (10-12/09/2026), fiabilité
  /// inconnue, sans rattrapage possible. Aucune donnée personnelle.
  endReason    String?
  /// Effectif total à l'écran (bots compris) et comptes humains.
  playerCount  Int
  humanCount   Int
  participants OnlineGameSessionPlayer[]

  // Liste « la plus récente d'abord » en Supervision.
  @@index([startedAt])
  // Fermeture de la partie en cours d'une salle (fin, revanche, purge).
  @@index([roomId, endedAt])
}

// Un participant d'une partie journalisée : SOIT un compte, SOIT un bot.
//
// RGPD : aucune COPIE du pseudo humain n'est stockée ici. Le nom est résolu à
// la LECTURE via la relation, si bien qu'une suppression de compte
// (deleteUserAccount → user.delete) vide `userId` (SetNull) et la ligne cesse
// définitivement de nommer qui que ce soit — l'écran affiche « compte
// supprimé ». Symétriquement, la ligne ne part PAS avec le compte : le journal
// d'exploitation doit rester lisible (même parti pris que AbuseReport).
// `botName` ne concerne que les pions du moteur (Gépéto, Suzette...) : ce n'est la
// donnée personnelle de personne.
model OnlineGameSessionPlayer {
  id        String            @id @default(cuid())
  sessionId String
  session   OnlineGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?             @relation("OnlineGameSessionPlayer", fields: [userId], references: [id], onDelete: SetNull)
  /// Nom d'affichage du BOT (null pour un compte : voir ci-dessus).
  botName   String?
  /// Rang d'affichage, tel que le moteur ordonnait la table au lancement.
  seat      Int               @default(0)

  @@index([sessionId])
  @@index([userId])
}

// Déblocage MANUEL d'un cosmétique (effet de pseudo / cadre) par un fondateur.
// La clé cosmétique = `kind:id` (ex. `frame:diamond`) — voir src/lib/online/cosmetics.ts.
model CosmeticGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("CosmeticGrantTarget", fields: [userId], references: [id], onDelete: Cascade)
  cosmeticKey String
  grantedById String?
  grantedBy   User?    @relation("CosmeticGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([userId, cosmeticKey])
}

model AccountBanEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("BanActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  comment     String?
  bannedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model SitePresence {
  visitorId        String   @id
  /// DERNIER compte vu sur ce navigateur : conservé quand un ping arrive sans
  /// session (seule trace du rapprochement), donc jamais « compte connecté ».
  userId           String?
  /// Dernier ping de ce navigateur fait AVEC une session valide, écrit avec la
  /// même date que lastSeen. Connecté ici = userSeenAt ≥ lastSeen, sans marge
  /// (isPresenceConnectedHere, src/lib/ip-history-server.ts). Null pour les
  /// lignes antérieures à cette colonne, jusqu'au prochain ping connecté.
  userSeenAt       DateTime?
  country          String?
  lastIp           String?
  lastDevice       String?
  localPlayerCount Int      @default(0)
  localPlayerNames String?
  /// Version du consentement aux statistiques sous laquelle la présence a été
  /// écrite en dernier : '2' (ANALYTICS_CONSENT_GRANTED, recordVisitorPing).
  /// NULL = ligne de l'ancien accord '1' (libellé « anonymes »), gardée par la
  /// migration 20260912130100_legacy_consent_cleanup seulement si elle est
  /// liée à un compte, sans pseudos locaux. Sert la couverture « visites
  /// suivies sur N navigateurs sur M » de la fiche et le filet du balayage.
  consentVersion   String?
  firstSeen        DateTime @default(now())
  lastSeen         DateTime @default(now())

  @@index([lastSeen])
  @@index([userId])
  @@index([country])
  @@index([lastIp])
}

model IpSeenLog {
  id         String   @id @default(cuid())
  subjectKey String
  ip         String
  country    String?
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())

  @@unique([subjectKey, ip])
  @@index([subjectKey])
  @@index([ip])
}

model DailyVisitor {
  visitorId String
  date      String

  @@id([visitorId, date])
  @@index([date])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // `sessions: { none }` du balayage des invités et cascade de suppression
  // de compte : clé étrangère non indexée par SQLite.
  @@index([userId])
  // Purge des sessions échues (retention-sweep) et « session encore valide ».
  @@index([expiresAt])
}

// VISITE d'un compte : suite de battements (page visible et utilisée) séparés
// de moins de 30 min, tous onglets et appareils confondus. ≠ Session, qui
// n'est qu'un jeton d'authentification (30 jours glissants, sans mesure
// d'usage). Écrite par recordAccountBeat (src/lib/account-visits-server.ts),
// seulement avec le consentement aux statistiques de visite ('2') et pour le
// rôle 'user' : le staff n'est jamais suivi.
//
// Minimisation : ni IP (déjà dans IpSeenLog), ni URL, ni jeu, ni pseudo, ni
// visitorId — des durées en secondes et une catégorie d'appareil. Pas de
// colonne de fin : elle se déduit de lastBeatAt à la lecture, sans clôture ni
// cron.
// Cascade (et non SetNull) : ce sont les données d'usage du joueur, sans
// valeur d'audit ; rien n'a à survivre au compte. Purge 6 mois après
// startedAt (retention-sweep.ts).
// Dates écrites par le client Prisma, donc en millisecondes epoch : tout SQL
// brut sur cette table doit raisonner en ms.
model AccountVisit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime @default(now())
  /// Dernier battement pris en compte (crédité ou non). Fin de la visite =
  /// lastBeatAt + 60 s (lecture) ; référence du crédit suivant
  /// (compare-and-swap, voir recordAccountBeat).
  lastBeatAt     DateTime @default(now())
  /// Somme des crédits : temps page visible et utilisée (pauses non comprises).
  visibleSeconds Int      @default(0)
  /// Crédits des battements avec interaction depuis 10 min au plus.
  activeSeconds  Int      @default(0)
  /// Crédits des battements sur un écran de jeu, local ou en ligne.
  gameSeconds    Int      @default(0)
  /// DeviceKind du premier battement : 'mobile' | 'tablet' | 'mac' | 'pc' ;
  /// null si non reconnu.
  device         String?

  // Visite ouverte à chaque battement, dernières visites d'un compte.
  @@index([userId, lastBeatAt])
  // Fenêtres de dates et purge.
  @@index([startedAt])
}

model Stats {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  gameType  String
  score     Int
  playedAt  DateTime @default(now())
  metadata  String?
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  unlockedAt DateTime @default(now())

  @@unique([userId, type])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserFeedback {
  id           String   @id @default(cuid())
  type         String
  message      String
  screenshots  String?
  pageUrl      String?
  userAgent    String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactEmail String?
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model ModerationTerm {
  id        String   @id @default(cuid())
  term      String
  locale    String?
  note      String?
  addedById String?
  createdAt DateTime @default(now())

  @@unique([term, locale])
  @@index([locale])
}

model NameModerationAttempt {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorId     String?
  attemptedName String
  reason        String
  context       String
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
  @@index([reason, createdAt])
  @@index([createdAt])
}

/// Réglages globaux du site (clé/valeur). Ex. : voiceEnabled = "1" | "0".
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Bannissement CIBLÉ d'une fonctionnalité (vocal ou chat écrit), indépendant
/// du ban de compte. `until` null = permanent ; sinon expire à cette date.
model FeatureBan {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("FeatureBanTarget", fields: [userId], references: [id], onDelete: Cascade)
  feature   String    // 'voice' | 'chat'
  until     DateTime?
  comment   String?
  actorId   String?
  actor     User?     @relation("FeatureBanActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@unique([userId, feature])
  @@index([userId])
}

/// Signalement d'abus posé par un joueur (message de chat ou joueur).
/// Deux principes :
///  - le signalement EMBARQUE de quoi instruire (`contextJson` : copie figée des
///    derniers messages du canal au moment du clic) plutôt que d'ouvrir au staff
///    une lecture live des conversations privées ;
///  - aucune clé étrangère vers ChatMessage : le message peut être purgé, le
///    dossier de modération lui survit.
/// Les liens vers les comptes sont NULLABLES / SetNull, jamais Cascade : la
/// suppression de compte est en libre-service, et une cascade laisserait
/// n'importe qui effacer d'un clic les dossiers en cours d'instruction —
/// y compris ceux qu'il a déposés CONTRE quelqu'un d'autre. Le dossier
/// survit donc au compte, orphelin mais lisible (même parti pris que
/// Feedback / NameModerationAttempt).
model AbuseReport {
  id             String    @id @default(cuid())
  reporterId     String?
  reporter       User?     @relation("AbuseReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUserId String?
  reportedUser   User?     @relation("AbuseReportTarget", fields: [reportedUserId], references: [id], onDelete: SetNull)
  /// 'message' (un message précis) | 'player' (comportement général)
  targetType     String
  /// ChatMessage.id quand targetType = 'message' — sans FK (voir ci-dessus).
  messageId      String?
  /// Canal concerné (`room:<id>`, `friend:<a>:<b>`, `wolves:<id>`) — réservé au staff.
  channel        String?
  /// Motif normalisé : voir REPORT_REASONS (src/lib/moderation/reports.ts).
  reason         String
  /// Précision libre du signalant, plafonnée côté route.
  comment        String?
  /// Extrait figé du canal au moment du signalement (JSON) — la seule fenêtre
  /// de lecture accordée au staff pour ce dossier.
  contextJson    String?
  /// 'open' | 'reviewed' | 'dismissed'
  status         String    @default("open")
  reviewedById   String?
  reviewedBy     User?     @relation("AbuseReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
}

/// Blocage unilatéral : `blocker` ne veut plus rien recevoir de `blocked`
/// (demande d'ami, message privé). Vérifié dans les DEUX sens à l'usage —
/// bloquer coupe la relation, pas seulement le sens sortant.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
