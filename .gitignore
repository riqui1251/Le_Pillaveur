# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.cursor/

# AI agent skills (npx skills — local only, do not push to GitHub)
.agents/
skills-lock.json
/skills/

# Absolute-Human board (état de travail local)
.absolute-human/
Le_Pillaveur/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# bases SQLite locales — journaux WAL compris : -wal et -shm portent des
# pages entières de la base (lignes User : e-mail, IP, jetons).
prisma/**/*.db
prisma/**/*.db-journal
prisma/**/*.db-wal
prisma/**/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
