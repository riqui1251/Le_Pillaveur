{
  "name": "mon-projet",
  "version": "1.1.01",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/sync-prisma-client.mjs && cross-env NODE_OPTIONS=--no-experimental-webstorage next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "prisma:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "prisma:check": "node scripts/check-prisma.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:local": "prisma db execute --file prisma/migrations/20250613120000_ip_history/migration.sql && prisma migrate resolve --applied 20250613120000_ip_history",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "accounts:backfill-codes": "node scripts/backfill-account-codes.mjs",
    "deploy:prepare": "node deploy-ftp.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.3",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.2",
    "geoip-lite": "^2.0.2",
    "konva": "^9.3.20",
    "lucide-react": "^0.476.0",
    "next": "^15.5.19",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.4",
    "node-cron": "^4.2.0",
    "react": "18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "18.3.1",
    "react-konva": "^19.0.3",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.3.0",
    "autoprefixer": "^10.4.14",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.4.14",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
